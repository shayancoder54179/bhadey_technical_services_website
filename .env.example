# ── Lead notification emails (Resend) ───────────────────────────────────────
# Every form submission, and every WhatsApp/Call button tap, emails these
# addresses via /api/lead. WhatsApp still works exactly as before — this runs
# alongside it and never delays or blocks the hand-off.
#
# With these unset the site runs normally and simply sends no email.

# From https://resend.com → API Keys. Server-side only, never sent to browsers.
RESEND_API_KEY=

# Comma-separated recipients.
LEAD_NOTIFY_TO=m.shayan54179@gmail.com

# Until a domain is verified in Resend, leave this as the shared test sender.
# Once bhadeya.com is verified there, switch to e.g. "Bhadeya Leads <leads@bhadeya.com>"
# — a verified domain is what keeps these out of the client's spam folder.
LEAD_NOTIFY_FROM=Bhadeya Leads <onboarding@resend.dev>
